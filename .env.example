# LLM provider (leave blank to disable; see GROWTHRADAR_LLM_PROVIDER resolution below).
# Used only for llm_summary.py's plain-English "why" explanation of the
# already-computed, rule-based verdict -- scoring itself never depends on this.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional vision-capable model for registration.py's screenshot-based
# fallback (only used when the DOM-based fill/click/choice-pick loop gets
# stuck). Leave blank to disable -- there is no default, since Groq's vision
# lineup changes and account access varies; verify a model actually accepts
# image input on your key before setting this (see vision_fallback.py).
GROQ_VISION_MODEL=

# auto (default: Groq if a key is set, otherwise heuristic) | groq | heuristic
GROWTHRADAR_LLM_PROVIDER=auto

# Collection behavior
GROWTHRADAR_REQUEST_TIMEOUT=10
GROWTHRADAR_MAX_PAGES=5
GROWTHRADAR_CRAWL_DELAY=0.5
# Wall-clock ceiling for one whole site (exploration + registration +
# onboarding exploration combined) -- see orchestrator.py.
GROWTHRADAR_SESSION_DEADLINE_SECONDS=160
GROWTHRADAR_USER_AGENT=GrowthRadarBot/0.1 (+https://userguiding.com; growth-intelligence-research)

# Storage & logging
GROWTHRADAR_DB_PATH=growthradar.db
GROWTHRADAR_LOG_LEVEL=INFO

# Registration form data (used to fill signup/free-trial forms)
GROWTHRADAR_COUNTRY=United States
# Leave blank to use a random generated company name each run
GROWTHRADAR_COMPANY=
# Leave blank for a random @example.com address. If set, used verbatim on
# every run -- useful for sites that reject @example.com as not a real work
# address, or that email a verification link/code to a real inbox you can
# check. Registering twice against the same target site can hit "email
# already in use" on the second attempt -- accepted tradeoff, not a bug.
GROWTHRADAR_EMAIL=
# Leave blank for a random generated name each run. If set, used verbatim
# for any "First name"/"Last name"/"Full name" field encountered.
GROWTHRADAR_FIRST_NAME=
GROWTHRADAR_LAST_NAME=

# Optional: read a real Gmail inbox over IMAP to open verification links and
# type in verification codes automatically (see temp_email.py's
# GmailImapProvider) -- takes priority over GROWTHRADAR_EMAIL above when both
# are set, since that address alone can't be read back. Each run uses its own
# "+tag" alias (mail to you+xyz@gmail.com still lands in your inbox), so a
# poll only ever matches the one message it's actually waiting on.
# GROWTHRADAR_GMAIL_APP_PASSWORD is an app password, not your account
# password (requires 2FA on the account) -- generate one at
# myaccount.google.com/apppasswords. Never opens a browser or touches
# Google's login/OAuth pages, so it's unaffected by the automation detection
# that blocks GROWTHRADAR_ALLOW_GOOGLE_OAUTH below.
GROWTHRADAR_GMAIL_ADDRESS=
GROWTHRADAR_GMAIL_APP_PASSWORD=

# Optional: complete "Continue with Google" instead of routing around it,
# using a real, already-authenticated Google Chrome profile. Requires:
#   1. Google Chrome installed (.venv/bin/python -m playwright install chrome)
#   2. A one-time manual sign-in to create the profile:
#      .venv/bin/python scripts/google_profile_bootstrap.py <profile_dir>
# GROWTHRADAR_ALLOW_GOOGLE_OAUTH alone does nothing without a profile dir set
# (and setting a profile dir alone doesn't turn this on) -- both are required.
# Only Google is ever unlocked this way; Facebook/Microsoft/etc. OAuth
# buttons are still routed around, same as always.
GROWTHRADAR_GOOGLE_PROFILE_DIR=
GROWTHRADAR_ALLOW_GOOGLE_OAUTH=false

# Scoring (weights must sum to 1.0)
GROWTHRADAR_HOT_THRESHOLD=70
GROWTHRADAR_WARM_THRESHOLD=40
GROWTHRADAR_WEIGHT_ICP_FIT=0.30
GROWTHRADAR_WEIGHT_ONBOARDING_OPPORTUNITY=0.45
GROWTHRADAR_WEIGHT_PRODUCT_EXPERIENCE=0.25
