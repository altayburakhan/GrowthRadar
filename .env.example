# Optional: enables real LLM-based reasoning via Claude. If unset, GrowthRadar
# automatically falls back to its built-in offline heuristic provider -- the
# platform is fully usable with no API key at all.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: free-tier-friendly alternative to Claude, via Groq's fast open-model
# API (e.g. Llama 3.3 70B). Get a free key at https://console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# auto (default: Claude > Groq > heuristic, first key found wins) | anthropic | groq | heuristic
GROWTHRADAR_LLM_PROVIDER=auto

# Collection behavior
GROWTHRADAR_REQUEST_TIMEOUT=10
GROWTHRADAR_MAX_PAGES=8
GROWTHRADAR_CRAWL_DELAY=0.5
GROWTHRADAR_USER_AGENT=GrowthRadarBot/0.1 (+https://userguiding.com; growth-intelligence-research)

# Storage & logging
GROWTHRADAR_DB_PATH=growthradar.db
GROWTHRADAR_LOG_LEVEL=INFO

# Scoring
GROWTHRADAR_HOT_THRESHOLD=70
GROWTHRADAR_WARM_THRESHOLD=40
GROWTHRADAR_WEIGHT_ICP_FIT=0.30
GROWTHRADAR_WEIGHT_ONBOARDING_OPPORTUNITY=0.45
GROWTHRADAR_WEIGHT_PRODUCT_EXPERIENCE=0.25
